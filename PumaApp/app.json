{
  "expo": {
    "name": "PumaApp",
    "slug": "PumaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme":"PumaApp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viktoriabroberg.pumaapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vi använder din position för att visa din plats på kartan.",
        "NSCameraUsageDescription": "Godkänn tillgång till kamera för att ta bild."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
